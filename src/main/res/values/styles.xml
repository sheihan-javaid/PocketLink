<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar because we use a Toolbar widget as ActionBar -->
    <style name="KdeConnectThemeBase" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kde_color_primary</item>
        <item name="colorOnPrimary">@color/kde_color_on_primary</item>
        <item name="colorPrimaryContainer">@color/kde_color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/kde_color_on_primary_container</item>
        <item name="colorSecondary">@color/kde_color_secondary</item>
        <item name="colorOnSecondary">@color/kde_color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/kde_color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/kde_color_on_secondary_container</item>
        <item name="colorTertiary">@color/kde_color_tertiary</item>
        <item name="colorOnTertiary">@color/kde_color_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/kde_color_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/kde_color_on_tertiary_container</item>
        <item name="colorError">@color/kde_color_error</item>
        <item name="colorOnError">@color/kde_color_on_error</item>
        <item name="colorErrorContainer">@color/kde_color_error_container</item>
        <item name="colorOnErrorContainer">@color/kde_color_on_error_container</item>
        <item name="colorSurface">@color/kde_color_surface</item>
        <item name="colorOnSurface">@color/kde_color_on_surface</item>
        <item name="colorSurfaceVariant">@color/kde_color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/kde_color_on_surface_variant</item>
        <item name="colorOutline">@color/kde_color_outline</item>
        <item name="colorOutlineVariant">@color/kde_color_outline_variant</item>
        <item name="colorOnBackground">@color/kde_color_on_background</item>
        <item name="kdeColorSuccess">@color/kde_color_success</item>
        <item name="kdeColorOnSuccess">@color/kde_color_on_success</item>
        <item name="kdeColorSuccessContainer">@color/kde_color_success_container</item>
        <item name="kdeColorOnSuccessContainer">@color/kde_color_on_success_container</item>
        <item name="kdeColorWarning">@color/kde_color_warning</item>
        <item name="kdeColorOnWarning">@color/kde_color_on_warning</item>
        <item name="kdeColorWarningContainer">@color/kde_color_warning_container</item>
        <item name="kdeColorOnWarningContainer">@color/kde_color_on_warning_container</item>
        <item name="kdeColorInformation">@color/kde_color_information</item>
        <item name="kdeColorOnInformation">@color/kde_color_on_information</item>
        <item name="kdeColorInformationContainer">@color/kde_color_information_container</item>
        <item name="kdeColorOnInformationContainer">@color/kde_color_on_information_container</item>
        <item name="kdeSpacingXsmall">@dimen/kde_spacing_xsmall</item>
        <item name="kdeSpacingSmall">@dimen/kde_spacing_small</item>
        <item name="kdeSpacingMediumSmall">@dimen/kde_spacing_medium_small</item>
        <item name="kdeSpacingMedium">@dimen/kde_spacing_medium</item>
        <item name="kdeSpacingLarge">@dimen/kde_spacing_large</item>
        <item name="kdeSpacingXlarge">@dimen/kde_spacing_xlarge</item>
        <item name="kdeMinTouchTarget">@dimen/kde_min_touch_target</item>
        <item name="kdeCornerSmall">@dimen/kde_corner_small</item>
        <item name="kdeCornerMedium">@dimen/kde_corner_medium</item>
        <item name="kdeCornerLarge">@dimen/kde_corner_large</item>
        <item name="kdeCornerExtraLarge">@dimen/kde_corner_extra_large</item>
        <item name="kdeContentMaxWidth">@dimen/kde_content_max_width</item>
        <item name="android:colorBackground">@color/kde_color_background</item>
        <item name="colorControlActivated">@color/kde_color_primary</item>

        <item name="materialCardViewStyle">@style/KdeConnectCardStyle</item>

        <!-- https://github.com/material-components/material-components-android/issues/2732 -->
        <item name="alertDialogTheme">@style/KdeConnectDialogStyle</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="KdeConnectTheme" parent="KdeConnectThemeBase" />

    <style name="KdeConnectThemeBase.NoActionBar" parent="KdeConnectTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="KdeConnectTheme.NoActionBar" parent="KdeConnectThemeBase.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>
    <style name="KdeConnectDialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:layout" tools:ignore="PrivateResource">@layout/m3_alert_dialog</item>
        <item name="dialogCornerRadius" tools:ignore="PrivateResource">@dimen/m3_alert_dialog_corner_size</item>
    </style>

    <style name="PreferenceThemeOverlay" parent="BasePreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
        <item name="switchPreferenceStyle">@style/Preference.SwitchPreferenceMaterial</item>
    </style>

    <style name="Preference.SwitchPreferenceMaterial" parent="Preference.SwitchPreference.Material">
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
    </style>

    <style name="KdeConnectCardStyle" parent="@style/Widget.Material3.CardView.Elevated"/>

    <style name="KdeConnectCardStyle.Filled" parent="@style/Widget.Material3.CardView.Filled"/>
    <style name="KdeConnectButton.IconButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">@dimen/kde_corner_large</item>
        <item name="android:minHeight">@dimen/kde_min_touch_target</item>
    </style>

    <style name="KdeConnectButton.IconButton.Secondary" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">@dimen/kde_corner_medium</item>
        <item name="android:minHeight">@dimen/kde_min_touch_target</item>
    </style>
    <style name="Theme.Transparent" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
