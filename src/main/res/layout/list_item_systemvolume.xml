<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sink_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/kde_spacing_small"
    app:cardCornerRadius="@dimen/kde_corner_large"
    app:cardElevation="0dp"
    app:contentPadding="@dimen/kde_spacing_medium"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/systemvolume_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/kde_spacing_small"
            android:paddingEnd="@dimen/kde_spacing_small"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Device name" />

        <LinearLayout
            android:id="@+id/systemvolume_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/kde_spacing_small"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/systemvolume_mute"
                android:layout_width="@dimen/kde_min_touch_target"
                android:layout_height="@dimen/kde_min_touch_target"
                android:background="@android:color/transparent"
                android:contentDescription="@string/mute"
                android:scaleType="fitXY"
                android:src="@drawable/ic_volume"/>

            <SeekBar
                android:id="@+id/systemvolume_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:max="100" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
