<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/pocketlink_min_touch_target"
    android:paddingStart="@dimen/pocketlink_spacing_medium"
    android:paddingEnd="@dimen/pocketlink_spacing_medium"
    android:paddingTop="@dimen/pocketlink_spacing_small"
    android:paddingBottom="@dimen/pocketlink_spacing_small"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:minHeight="@dimen/pocketlink_min_touch_target"
        android:gravity="center_vertical"
        android:paddingEnd="@dimen/pocketlink_spacing_small"
        tools:ignore="RtlSymmetry"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Plugin Title" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Plugin Description" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/pocketlink_spacing_small"
        android:layout_marginEnd="@dimen/pocketlink_spacing_small"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/pocketlink_min_touch_target"
        android:minHeight="@dimen/pocketlink_min_touch_target"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:orientation="vertical" />

</LinearLayout>
