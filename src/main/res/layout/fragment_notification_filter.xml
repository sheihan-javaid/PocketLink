<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="org.kde.kdeconnect.plugins.notifications.NotificationsSettingsFragment">

    <!-- Receives the PreferenceFragmentCompat view, with the preferences from notificationsplugin_preferences.xml -->
    <FrameLayout
        android:id="@+id/preferencesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/pocketlink_spacing_medium"
        android:paddingEnd="@dimen/pocketlink_spacing_medium" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pocketlink_spacing_medium"
        android:layout_marginTop="@dimen/pocketlink_spacing_small"
        android:layout_marginEnd="@dimen/pocketlink_spacing_medium"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="?attr/pocketlinkCornerLarge"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/pocketlink_spacing_medium"
            android:text="@string/filter_apps_info"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/pocketlink_spacing_xlarge"
        android:indeterminateTint="?attr/colorPrimary" />

    <ListView
        android:id="@+id/lvFilterApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/pocketlink_spacing_medium"
        android:layout_marginTop="@dimen/pocketlink_spacing_small"
        android:layout_marginEnd="@dimen/pocketlink_spacing_medium"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/pocketlink_spacing_small"
        android:paddingBottom="@dimen/pocketlink_spacing_medium"
        android:visibility="gone" />

</LinearLayout>
